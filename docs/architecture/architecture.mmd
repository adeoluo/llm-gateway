flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>complete, inspect"]:::edge
        Router["HTTP service<br/>/complete /stats"]:::core
        Validate["Validation<br/>prompt, max 20000"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph Core["Safety pipeline"]
        direction TB
        Inject["Injection check<br/>block at score 0.8"]:::control
        RedactIn["Input PII redaction<br/>typed placeholders"]:::control
        Provider["Provider<br/>optional retry, failover"]:::core
        Claude([Anthropic API<br/>optional provider]):::edge
        Policy["Output policy<br/>deny list, length cap"]:::control
        RedactOut["Output PII redaction"]:::control
        Inject -->|allowed| RedactIn --> Provider --> Policy -->|allowed| RedactOut ~~~ Claude
        Provider -.-> Claude
    end

    subgraph State["Data and state"]
        direction TB
        Cache[("Semantic cache<br/>token-similar prompts")]:::data
        Suite[("Adversarial suite<br/>labeled cases")]:::data
        Cache ~~~ Suite
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Response["Response JSON<br/>status and reasons"]:::obs
        Stats["Gateway stats<br/>hits, blocks, calls"]:::obs
        Report["Defense report<br/>injection, PII, savings"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Response ~~~ Stats ~~~ Report ~~~ Metrics
    end

    Interfaces -->|prompt| Core
    Core -->|cache| State
    Core -->|result| Obs
    State -.->|cases| Obs
